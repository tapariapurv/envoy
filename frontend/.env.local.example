# Firebase web app config (Firebase console → Project settings → Your apps). Public by design; firestore.rules guards the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Google Apps Script web app URL for emailing invites (see apps-script/Code.gs)
NEXT_PUBLIC_MAIL_URL=
